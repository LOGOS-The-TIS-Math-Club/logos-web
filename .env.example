# Environment variables baseline for LOGOS Web
# Real secrets belong in ignored .env.local, Vercel secrets, Neon credentials, or GitHub secrets.
# Values are opaque placeholders, not connection strings or credentials.

# Runtime environment safety label (development | preview | test | production)
APP_ENV=development

# Pooled application runtime database connection URL (PostgreSQL)
DATABASE_URL=replace-with-runtime-pooled-url

# Direct migration owner database connection URL (PostgreSQL)
MIGRATION_DATABASE_URL=replace-with-migration-direct-url

# Dedicated test database connection URL (PostgreSQL) for isolated test runs
TEST_DATABASE_URL=replace-with-isolated-test-url

# Read-only backup/export database connection URL (PostgreSQL)
BACKUP_DATABASE_URL=replace-with-read-only-backup-url

# Phase 03: Request Security, Origins, and Anti-CSRF
# Canonical origin URL for primary web application (scheme + domain + optional port)
APP_URL=http://localhost:3000

# Semicolon-separated explicit list of additional trusted origins (no wildcards allowed)
TRUSTED_ORIGINS=http://localhost:3000

# Minimum 32-byte secret key for HMAC-SHA256 CSRF double-submit token signing
CSRF_SIGNING_SECRET=replace-with-a-secure-random-at-least-32-byte-string-in-production

# Minimum 32-byte secret key for HMAC-SHA256 rate limit subject hashing
RATE_LIMIT_SECRET=replace-with-a-secure-random-at-least-32-byte-string-in-production

# Phase 04: Neon Auth and the matching non-production Google OAuth web client
# Leave unset to keep authentication disabled. Never use NEXT_PUBLIC_ for these values.
# NEON_AUTH_BASE_URL=https://replace-with-nonproduction-auth-endpoint
# NEON_AUTH_COOKIE_SECRET=replace-with-a-secure-random-at-least-32-character-secret
# GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Optional Sentry DSN for error telemetry (zero-cost Developer free tier, disabled if omitted)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
