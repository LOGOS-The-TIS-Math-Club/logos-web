# Only a NEW, empty development database; never point initial migrations at legacy.
DATABASE_URL_UNPOOLED=postgresql://localhost/logos_dev
# Application runtime uses a pooled URL with a restricted application login.
DATABASE_URL=postgresql://localhost/logos_dev
APP_URL=http://localhost:3000
# From the selected development branch's hosted Better Auth settings.
NEON_AUTH_BASE_URL=https://your-development-endpoint.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Generate locally: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Exact Google OAuth client audience used by the hosted Auth provider.
GOOGLE_OAUTH_CLIENT_ID=
