{
  "name": "logos-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "auth:check": "node scripts/check-auth-config.mjs",
    "db:generate": "drizzle-kit generate",
    "db:test:configure": "node scripts/db/configure-test-environment.mjs",
    "db:test:roles": "node scripts/db/provision-test-roles.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:check": "node scripts/db/check-migrations.mjs",
    "db:fixtures": "node scripts/db/load-fixtures.mjs",
    "db:test": "node scripts/db/test-foundation.mjs",
    "db:restore:verify": "node scripts/db/verify-restore.mjs",
    "db:access:bootstrap": "node scripts/db/bootstrap-access-admin.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ci": "playwright test",
    "release:verify": "node scripts/verify-release-config.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build && pnpm test:e2e:ci"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/nextjs": "10.73.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.5",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
